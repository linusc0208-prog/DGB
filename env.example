# Nur für den lokalen Test (npm run dev). Bei Vercel trägst du dieselben Werte
# unter Settings → Environment Variables ein.

# Supabase → Project Settings → API (bzw. "API Keys")
SUPABASE_URL=https://DEINE-PROJEKT-ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# aus "npm run vapid"
VAPID_PUBLIC_KEY=

# optional: eigener Geodienst für Straßennamen, "off" schaltet ab
# GEOCODER_URL=https://nominatim.openstreetmap.org
